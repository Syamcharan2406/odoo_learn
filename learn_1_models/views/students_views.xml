<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="school_student_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list string="Student">
                <field name="name"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <group>
                                <field colspan="2" name="notes" nolabel="1" placeholder="This note is only for internal purposes."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Menu and Action -->
    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">School Student</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
