<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Inherit base ListView buttons -->
    <t t-name="sale.SaleOrderListView.Buttons"
       t-inherit="web.ListView.Buttons"
       t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <t t-call="sale.SaleOrderCustomButtons"/>
        </xpath>
    </t>

    <!-- Define custom buttons -->
    <t t-name="sale.SaleOrderCustomButtons">
        <div class="d-flex gap-2 ms-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    t-on-click="() => this.filterByProductType('aircraft')">
                Aircraft
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    t-on-click="() => this.filterByProductType('engine')">
                Engine
            </button>
        </div>
    </t>



    <t t-name="sale.SaleOrderListView"
       t-inherit="web.ListView"
       t-inherit-mode="primary">

        <!-- Placeholder to add custom buttons before 'Create' -->
        <xpath expr="//button[hasclass('o_list_button_add')]" position="before">
            <!-- Custom sale order buttons can be added here -->
        </xpath>

        <!-- Example of adding custom attributes to Renderer -->
        <xpath expr="//t[@t-component='props.Renderer']" position="attributes">
            <!-- You can bind controller functions later if needed -->
            <!-- Example: <attribute name="customAction.bind">customAction</attribute> -->
        </xpath>
    </t>

</templates>
